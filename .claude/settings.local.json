{
  "permissions": {
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "WebFetch(domain:www.npmjs.com)",
      "Bash(npm run type-check:*)",
      "Bash(npx tsc:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(find:*)",
      "Bash(npm run lint)",
      "Bash(npm run build:*)",
      "Bash(node:*)",
      "Bash(cat:*)",
      "Bash(npx prettier:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:run:*)",
      "Bash(npm run test:*)",
      "Bash(test:*)",
      "Bash(awk NR==119 || NR==210:*)"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "local-agents": {
      "source": {
        "source": "directory",
        "path": ".claude/agents"
      }
    }
  }
}
