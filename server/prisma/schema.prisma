generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model actionLogs {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime         DateTime           @map("start_time") @db.Timestamptz(6)
  endTime           DateTime?          @map("end_time") @db.Timestamptz(6)
  durationSeconds   Int?               @map("duration_seconds")
  actionDate        DateTime           @default(dbgenerated("CURRENT_DATE")) @map("action_date") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  actionTypeId      String             @map("action_type_id") @db.Uuid
  actionTypes       actionTypes        @relation(fields: [actionTypeId], references: [id], map: "fk_actions_action_type_id")
  developmentLogs   developmentLogs?
  pronunciationLogs pronunciationLogs?
  readingLogs       readingLogs?

  @@index([actionTypeId], map: "idx_actions_action_type_id")
  @@index([actionTypeId, startTime(sort: Desc)], map: "idx_actions_action_type_start_time")
  @@index([actionDate], map: "idx_actions_date")
  @@index([startTime(sort: Desc)], map: "idx_actions_start_time")
  @@map("action_logs")
}

model actionTypes {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastActionDate          DateTime?                @map("last_action_date") @db.Timestamptz(6)
  totalActionsCount       Int                      @default(0) @map("total_actions_count")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  habitId                 String                   @map("habit_id") @db.Uuid
  globalIdentifierId      String?                  @map("global_identifier_id") @db.Uuid
  actionLogs              actionLogs[]
  globalEntityIdentifiers globalEntityIdentifiers? @relation(fields: [globalIdentifierId], references: [id], onDelete: Restrict, map: "fk_action_types_global_identifier")
  habits                  habits                   @relation(fields: [habitId], references: [id], onDelete: Cascade, map: "fk_action_types_habit_id")

  @@index([createdAt], map: "idx_action_types_created_at")
  @@index([globalIdentifierId], map: "idx_action_types_global_identifier_id")
  @@index([habitId, totalActionsCount(sort: Desc)], map: "idx_action_types_habit_actions_count")
  @@index([habitId], map: "idx_action_types_habit_id")
  @@index([totalActionsCount(sort: Desc)], map: "idx_action_types_total_actions_count")
  @@map("action_types")
}

model books {
  id                           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String        @db.VarChar(100)
  image                        String?
  totalPages                   Int           @map("total_pages")
  currentPage                  Int           @default(0) @map("current_page")
  averageOfCharactersPerMinute Float?        @map("average_of_characters_per_minute")
  author                       String?       @db.VarChar(100)
  genre                        String?       @db.VarChar(50)
  completionPercentage         Decimal?      @default(dbgenerated("\nCASE\n    WHEN (totalPages > 0) THEN round((((current_page)::numeric / (total_pages)::numeric) * (100)::numeric), 2)\n    ELSE (0)::numeric\nEND")) @map("completion_percentage") @db.Decimal(5, 2)
  totalReadingSessions         Int           @default(0) @map("total_reading_sessions")
  totalCharactersRead          BigInt        @default(0) @map("total_characters_read")
  averageSessionDuration       Int           @default(0) @map("average_session_duration")
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  isActive                     Boolean       @default(true) @map("is_active")
  readingLogs                  readingLogs[]

  @@index([completionPercentage], map: "idx_books_completion")
  @@index([totalReadingSessions(sort: Desc)], map: "idx_books_total_sessions")
}

model developmentLogs {
  id                                                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commitName                                          String                @map("commit_name") @db.VarChar(255)
  description                                         String                @db.VarChar(2000)
  commitHash                                          String                @map("commit_hash") @db.VarChar(1000)
  isForMe                                             Boolean               @map("is_for_me")
  createdAt                                           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  actionId                                            String                @unique(map: "development_logs_action_id_unique") @map("action_id") @db.Uuid
  featuresId                                          String?               @map("features_id") @db.Uuid
  commitSizeId                                        Int                   @map("commit_size_id")
  commitImportanceId                                  Int                   @map("commit_importance_id")
  programmingLanguageId                               Int                   @map("programming_language_id")
  externalDependencyId                                Int?                  @map("external_dependency_id")
  actionLogs                                          actionLogs            @relation(fields: [actionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_action_logs_fk")
  subtypesDevelopmentLogsCommitImportanceIdTosubtypes subtypes              @relation("development_logs_commit_importance_idTosubtypes", fields: [commitImportanceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_commit_importance_fk")
  subtypesDevelopmentLogsCommitSizeIdTosubtypes       subtypes              @relation("development_logs_commit_size_idTosubtypes", fields: [commitSizeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_commit_size_fk")
  externalDependencies                                externalDependencies? @relation(fields: [externalDependencyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_external_dependencies_fk")
  features                                            features?             @relation(fields: [featuresId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_features_fk")
  programmingLanguages                                programmingLanguages  @relation(fields: [programmingLanguageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "development_logs_programming_languages_fk")

  @@map("development_logs")
}

model externalDependencies {
  id                    Int                  @id @default(autoincrement())
  name                  String               @db.VarChar(100)
  programmingLanguageId Int                  @map("programming_language_id")
  developmentLogs       developmentLogs[]
  programmingLanguages  programmingLanguages @relation(fields: [programmingLanguageId], references: [id], onDelete: Cascade, map: "external_dependencies_programming_languages_fk")

  @@map("external_dependencies")
}

model features {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(50)
  description     String            @db.VarChar(1000)
  developmentLogs developmentLogs[]
}

model globalEntityIdentifiers {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique(map: "global_entity_identifiers_name_unique") @db.VarChar(255)
  icon        String        @unique(map: "global_entity_identifiers_icon_unique")
  entityType  String        @map("entity_type") @db.VarChar(20)
  entityId    String        @map("entity_id") @db.Uuid
  actionTypes actionTypes[]
  habits      habits[]

  @@unique([entityType, entityId], map: "global_entity_identifiers_entity_unique")
  @@unique([name, icon], map: "global_entity_identifiers_name_icon_unique")
  @@index([entityType, entityId], map: "idx_global_entity_identifiers_entity_lookup")
  @@index([name], map: "idx_global_entity_identifiers_name_prefix")
  @@map("global_entity_identifiers")
}

model habits {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitType               habitComplexity          @map("habit_type")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  isActive                Boolean                  @default(true) @map("is_active")
  totalActionsCount       Int                      @default(0) @map("total_actions_count")
  lastActionDate          DateTime?                @map("last_action_date") @db.Timestamptz(6)
  globalIdentifierId      String?                  @map("global_identifier_id") @db.Uuid
  actionTypes             actionTypes[]
  globalEntityIdentifiers globalEntityIdentifiers? @relation(fields: [globalIdentifierId], references: [id], onDelete: Restrict, map: "fk_habits_global_identifier")

  @@index([createdAt], map: "idx_habits_created_at")
  @@index([globalIdentifierId], map: "idx_habits_global_identifier_id")
}

model programmingLanguages {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(50)
  developmentLogs      developmentLogs[]
  externalDependencies externalDependencies[]

  @@map("programming_languages")
}

model pronunciationLogs {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId           String     @unique @map("action_id") @db.Uuid
  originalText       String     @map("original_text")
  speechToTextResult String     @map("speech_to_text_result")
  accuracyPercentage Decimal    @map("accuracy_percentage") @db.Decimal(5, 2)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  actionLogs         actionLogs @relation(fields: [actionId], references: [id], onDelete: Cascade, map: "pronunciation_logs_action_logs_fk")

  @@index([accuracyPercentage], map: "idx_pronunciation_logs_accuracy")
  @@index([actionId], map: "idx_pronunciation_logs_action_id")
  @@index([createdAt], map: "idx_pronunciation_logs_created_at")
  @@map("pronunciation_logs")
}

model readingLogs {
  id                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId                    String     @unique @map("action_id") @db.Uuid
  bookId                      String     @map("book_id") @db.Uuid
  numberOfCharacters          Int        @map("number_of_characters")
  breaths                     Int
  numberOfCharactersPerMinute Float      @map("number_of_characters_per_minute")
  numberOfBreathsPerMinute    Float      @map("number_of_breaths_per_minute")
  usingVoice                  Boolean    @default(false) @map("using_voice")
  readingDate                 DateTime?  @map("reading_date") @db.Date
  sessionDurationSeconds      Int?       @map("session_duration_seconds")
  readingEfficiency           Decimal?   @default(dbgenerated("\nCASE\n    WHEN (numberOfBreathsPerMinute > (0)::double precision) THEN round(((numberOfCharactersPerMinute / number_of_breaths_per_minute))::numeric, 2)\n    ELSE NULL::numeric\nEND")) @map("reading_efficiency") @db.Decimal(5, 2)
  createdAt                   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  books                       books      @relation(fields: [bookId], references: [id], map: "fk_reading_logs_book_id")
  actionLogs                  actionLogs @relation(fields: [actionId], references: [id], onDelete: Cascade, map: "reading_logs_action_logs_fk")

  @@index([bookId, readingDate], map: "idx_reading_logs_book_date")
  @@index([bookId], map: "idx_reading_logs_book_id")
  @@index([numberOfCharactersPerMinute], map: "idx_reading_logs_char_rate")
  @@index([readingDate], map: "idx_reading_logs_date")
  @@index([usingVoice, bookId], map: "idx_reading_logs_voice")
  @@map("reading_logs")
}

model subtypes {
  id                                                         Int               @id @default(autoincrement())
  typeId                                                     Int               @map("type_id")
  name                                                       String            @db.VarChar(100)
  description                                                String            @db.VarChar(1000)
  developmentLogsDevelopmentLogsCommitImportanceIdTosubtypes developmentLogs[] @relation("development_logs_commit_importance_idTosubtypes")
  developmentLogsDevelopmentLogsCommitSizeIdTosubtypes       developmentLogs[] @relation("development_logs_commit_size_idTosubtypes")
  types                                                      types             @relation(fields: [typeId], references: [id], onDelete: Cascade, map: "subtypes_types_fk")
}

model types {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  description String     @db.VarChar(1000)
  subtypes    subtypes[]
}

enum habitComplexity {
  complex          @map("Complex")
  simple           @map("Simple")
  withoutIntervals @map("Without Intervals")

  @@map("habit_complexity")
}
